# 복사해서 .env 로 저장 후 키 입력 (.env 는 Git에 커밋 금지)
ANTHROPIC_API_KEY=
# 조직 단위 키일 때만: Console > Settings > Workspaces 의 워크스페이스 ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
# 무료 사용량은 Flash 모델만 가능. Pro 모델은 Google AI Studio 결제 등록 필요
GEMINI_API_KEY=
# 휴대폰 접속(--lan)용 접속 키. 비워 두면 서버를 켤 때마다 새 키를 만들어 터미널·QR 에 표시한다.
# 매번 바뀌는 게 불편하면 주석(#)을 지우고 추측하기 어려운 값(12자 이상)을 넣으세요.
# ACCESS_KEY=

# ── 브레인 모드 메일 요약(Gmail) ──
# 방법 ①(권장): 이 컴퓨터의 claude CLI 에 claude.ai Gmail 커넥터가 연결돼 있으면 아무것도 넣지 않아도 자동으로 씁니다(읽기 전용 도구만 허용).
# 방법 ②: 아래에 Gmail 주소와 앱 비밀번호를 넣습니다. 둘 다 있으면 ② 를 먼저 쓰고, 로그인에 실패하면 ① 로 넘어갑니다.
# GMAIL_SOURCE=auto        # auto | claude | imap | off
# GMAIL_CLAUDE_MODEL=haiku # 방법 ① 에서 읽고 요약할 claude 모델
# Google 계정 → 보안 → 2단계 인증을 켠 뒤 '앱 비밀번호'를 만들어 16자리를 넣으세요(일반 비밀번호는 안 됨).
# Gmail 설정 → '전달 및 POP/IMAP' 에서 IMAP 이 켜져 있어야 합니다. 메일함은 읽기만 합니다. 저장하면 서버를 다시 켜지 않아도 반영됩니다.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 선택: 며칠 치(기본 3, 최대 14) · 최대 개수(기본 15, 최대 40) · 요약할 팀원(team.toml 의 이름, 기본 gemini)
# GMAIL_DAYS=3
# GMAIL_MAX=15
# GMAIL_SUMMARY_MEMBER=gemini

# ── 브레인 모드 바로가기(Vercel 가져오기) ──
# 이 컴퓨터에서 `npx vercel login` 을 한 번 했다면 비워 둬도 됩니다(Vercel CLI 의 저장된 로그인 사용). 프로젝트 목록 읽기만 합니다.
# 또는 vercel.com → Settings → Tokens 에서 만든 토큰:
# VERCEL_TOKEN=
